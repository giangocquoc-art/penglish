{
  "buildCommand": "npm run build -w @pshare/web",
  "installCommand": "npm install",
  "outputDirectory": "apps/web/dist",
  "headers": [
    {
      "source": "/assets/:file([^/]+-[A-Za-z0-9_-]{8,}\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:file([^/]+-[A-Za-z0-9_-]{8,}\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
